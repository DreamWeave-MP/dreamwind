function Sc.NiMorphData(b: buffer, p: number, L: Links, n: number): (number, number)
  local _numTargets = buffer.readu32(b, p)
  local _numVertices = buffer.readu32(b, p + 4)
  S.morphVertices = _numVertices
  p += 9

  for _ = 1, _numTargets do
    p, n = Sc.MorphTarget(b, p, L, n)
  end

  return p, n
end

function Sc.NiVisData(b: buffer, p: number, L: Links, n: number): (number, number)
  local keysCount = buffer.readu32(b, p)
  p += 4
  p += keysCount * 5

  return p, n
end

