function Sc.NiTriShapeDynamicData(b: buffer, p: number, L: Links, n: number): (number, number)
  local _numVertices = buffer.readu16(b, p)
  local _hasVertices = buffer.readu32(b, p + 2)
  local _count = _hasVertices ~= 0 and _numVertices or 0
  S.vertexCount = _count
  p += 6
  p += _count * 12
  local _hasNormals = buffer.readu32(b, p)
  p += 4
  p += (_hasNormals ~= 0 and _count or 0) * 12
  local _hasVertexColors = buffer.readu32(b, p + 16)
  p += 20
  p += (_hasVertexColors ~= 0 and _count or 0) * 16
  local _numUvSets = buffer.readu16(b, p)
  local _hasUvSets = buffer.readu32(b, p + 2)
  p += 6
  p, n = C.uvSets(b, p, L, n, _hasUvSets ~= 0 and _numUvSets or 0, _count)
  local _numTriangles = buffer.readu16(b, p)
  local _numTrianglePoints = buffer.readu32(b, p + 2)
  p += 6
  p += (_numTrianglePoints // 3) * 6
  p, n = C.sharedNormals(b, p, L, n)
  p += 4

  return p, n
end

