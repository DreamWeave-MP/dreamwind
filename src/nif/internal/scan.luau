function Sc.NiScreenPolygon(b: buffer, p: number, L: Links, n: number): (number, number)
  local _numVertices = buffer.readu16(b, p)
  p += 2
  p += _numVertices * 12
  local _hasUvCoords = buffer.readu32(b, p)
  p += 4
  p += (_hasUvCoords ~= 0 and _numVertices or 0) * 8
  local _hasVertexColors = buffer.readu32(b, p)
  p += 4
  p += (_hasVertexColors ~= 0 and _numVertices or 0) * 16
  local propertyStatesCount = buffer.readu32(b, p)
  p += 4
  p += propertyStatesCount * 4

  return p, n
end

