function read.NiTexturingPropertyTexture(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local enabled
  local sourceTexture = -1
  local clamp = 0
  local filter = 0
  local _flags = 0
  local maxAnisotropy = 0
  local uvSet = 0
  local hasTransform = false
  local transform = D.NiTextureTransform()

  if V < 0x04010000 then
    enabled = buffer.readi32(b, p) ~= 0
    p += 4
  else
    enabled = buffer.readi8(b, p) ~= 0
    p += 1
  end

  if not not enabled then
    if V >= 0x0303000D then
      sourceTexture = buffer.readi32(b, p)
      p += 4
      if sourceTexture < -1 then G.invalidLink(sourceTexture) end
    end

    if V <= 0x14000005 then
      clamp = buffer.readu32(b, p)
      p += 4
    end

    if V <= 0x14000005 then
      filter = buffer.readu32(b, p)
      p += 4
    end

    if V > 0x14000005 then
      _flags = buffer.readu16(b, p)
      p += 2
    end

    if V > 0x14000005 then clamp = bit32.band(_flags, 15) end

    if V > 0x14000005 then filter = bit32.extract(_flags, 4, 4) end

    if V >= 0x14050004 then
      maxAnisotropy = buffer.readu16(b, p)
      p += 2
    end

    if V <= 0x14000005 then
      uvSet = buffer.readu32(b, p)
      p += 4
    end

    if V <= 0x0A040001 then p = G.skip(s, p, 4) end

    if V <= 0x0401000C then p = G.skip(s, p, 2) end

    if V >= 0x0A010000 then
      if V < 0x04010000 then
        hasTransform = buffer.readi32(b, p) ~= 0
        p += 4
      else
        hasTransform = buffer.readi8(b, p) ~= 0
        p += 1
      end
    end

    if hasTransform then
      transform = {
        offset = vector.create(buffer.readf32(b, p), buffer.readf32(b, p + 4), 0),
        scale = vector.create(buffer.readf32(b, p + 8), buffer.readf32(b, p + 12), 0),
        rotation = buffer.readf32(b, p + 16),
        transformMethod = buffer.readu32(b, p + 20),
        origin = vector.create(buffer.readf32(b, p + 24), buffer.readf32(b, p + 28), 0),
      }
      p += 32
    end
  end

  return {
    enabled = enabled,
    sourceTexture = sourceTexture,
    clamp = clamp,
    filter = filter,
    maxAnisotropy = maxAnisotropy,
    uvSet = uvSet,
    hasTransform = hasTransform,
    transform = transform,
  },
    p
end

function default.NiTexturingPropertyTexture(): any
  local made = shared.NiTexturingPropertyTexture
  if made then return made end

  made = table.freeze {
    enabled = false,
    sourceTexture = -1,
    clamp = 0,
    filter = 0,
    maxAnisotropy = 0,
    uvSet = 0,
    hasTransform = false,
    transform = D.NiTextureTransform(),
  }
  shared.NiTexturingPropertyTexture = made
  return made
end

