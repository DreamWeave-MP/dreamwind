function read.bhkRigidBodyCInfo(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local havokFilter
  local responseType = 0
  local processContactDelay = 0
  local translation
  local rotation
  local linearVelocity
  local angularVelocity
  local _row1
  local _row2
  local _row3
  local inertiaTensor
  local center
  local mass
  local linearDamping
  local angularDamping
  local timeFactor = 1
  local gravityFactor
  local friction
  local rollingFrictionMult
  local restitution
  local maxLinearVelocity
  local maxAngularVelocity
  local penetrationDepth = 0
  local motionType
  local deactivatorType
  local enableDeactivation
  local solverDeactivation
  local qualityType
  local autoRemoveLevel
  local responseModifierFlags
  local numContactPointShapeKeys
  local forceCollidedOntoPpu

  if V >= 0x0A010000 then p = G.skip(s, p, 4) end

  if V >= 0x0A010000 then
    havokFilter = {
      layer = buffer.readu8(b, p),
      flags = buffer.readu8(b, p + 1),
      group = buffer.readu16(b, p + 2),
    }
    p += 4
  else
    havokFilter = D.HavokFilter()
  end

  if V >= 0x0A010000 then p = G.skip(s, p, 4) end

  if V >= 0x0A010000 and BV ~= 130 and BV >= 83 then p = G.skip(s, p, 4) end

  if V >= 0x0A010000 and BV ~= 130 then
    responseType = buffer.readu8(b, p)
    p += 1
  end

  if V >= 0x0A010000 and BV ~= 130 then p = G.skip(s, p, 1) end

  if V >= 0x0A010000 and BV ~= 130 then
    processContactDelay = buffer.readu16(b, p)
    p += 2
  end

  if BV < 83 then p = G.skip(s, p, 4) end

  translation = {
    buffer.readf32(b, p),
    buffer.readf32(b, p + 4),
    buffer.readf32(b, p + 8),
    buffer.readf32(b, p + 12),
  }
  p += 16
  rotation = {
    buffer.readf32(b, p + 4),
    buffer.readf32(b, p + 8),
    buffer.readf32(b, p + 12),
    buffer.readf32(b, p),
  }
  p += 16
  linearVelocity = {
    buffer.readf32(b, p),
    buffer.readf32(b, p + 4),
    buffer.readf32(b, p + 8),
    buffer.readf32(b, p + 12),
  }
  p += 16
  angularVelocity = {
    buffer.readf32(b, p),
    buffer.readf32(b, p + 4),
    buffer.readf32(b, p + 8),
    buffer.readf32(b, p + 12),
  }
  p += 16
  _row1 = vector.create(buffer.readf32(b, p), buffer.readf32(b, p + 4), buffer.readf32(b, p + 8))
  p += 12
  p = G.skip(s, p, 4)
  _row2 = vector.create(buffer.readf32(b, p), buffer.readf32(b, p + 4), buffer.readf32(b, p + 8))
  p += 12
  p = G.skip(s, p, 4)
  _row3 = vector.create(buffer.readf32(b, p), buffer.readf32(b, p + 4), buffer.readf32(b, p + 8))
  p += 12
  p = G.skip(s, p, 4)
  inertiaTensor = { _row1, _row2, _row3 }
  center = {
    buffer.readf32(b, p),
    buffer.readf32(b, p + 4),
    buffer.readf32(b, p + 8),
    buffer.readf32(b, p + 12),
  }
  p += 16
  mass = buffer.readf32(b, p)
  p += 4
  linearDamping = buffer.readf32(b, p)
  p += 4
  angularDamping = buffer.readf32(b, p)
  p += 4

  if BV >= 83 and BV ~= 130 then
    timeFactor = buffer.readf32(b, p)
    p += 4
  end

  if BV >= 83 then
    gravityFactor = buffer.readf32(b, p)
    p += 4
  else
    gravityFactor = 1
  end

  friction = buffer.readf32(b, p)
  p += 4

  if BV >= 83 then
    rollingFrictionMult = buffer.readf32(b, p)
    p += 4
  else
    rollingFrictionMult = 0
  end

  restitution = buffer.readf32(b, p)
  p += 4

  if V >= 0x0A010000 then
    maxLinearVelocity = buffer.readf32(b, p)
    p += 4
  else
    maxLinearVelocity = 0
  end

  if V >= 0x0A010000 then
    maxAngularVelocity = buffer.readf32(b, p)
    p += 4
  else
    maxAngularVelocity = 0
  end

  if V >= 0x0A010000 and BV ~= 130 then
    penetrationDepth = buffer.readf32(b, p)
    p += 4
  end

  motionType = buffer.readu8(b, p)
  p += 1

  if BV < 83 then
    deactivatorType = buffer.readu8(b, p)
    p += 1
  else
    deactivatorType = 0
  end

  if BV >= 83 then
    if V < 0x04010000 then
      enableDeactivation = buffer.readi32(b, p) ~= 0
      p += 4
    else
      enableDeactivation = buffer.readi8(b, p) ~= 0
      p += 1
    end
  else
    enableDeactivation = true
  end

  solverDeactivation = buffer.readu8(b, p)
  p += 1

  if BV == 130 then p = G.skip(s, p, 1) end

  if BV == 130 then
    penetrationDepth = buffer.readf32(b, p)
    p += 4
  end

  if BV == 130 then
    timeFactor = buffer.readf32(b, p)
    p += 4
  end

  if BV == 130 then p = G.skip(s, p, 4) end

  if BV == 130 then
    responseType = buffer.readu8(b, p)
    p += 1
  end

  if BV == 130 then p = G.skip(s, p, 1) end

  if BV == 130 then
    processContactDelay = buffer.readu16(b, p)
    p += 2
  end

  qualityType = buffer.readu8(b, p)
  p += 1

  if BV >= 83 then
    autoRemoveLevel = buffer.readu8(b, p)
    p += 1
  else
    autoRemoveLevel = 0
  end

  if BV >= 83 then
    responseModifierFlags = buffer.readu8(b, p)
    p += 1
  else
    responseModifierFlags = 0
  end

  if BV >= 83 then
    numContactPointShapeKeys = buffer.readu8(b, p)
    p += 1
  else
    numContactPointShapeKeys = 0
  end

  if BV >= 83 then
    if V < 0x04010000 then
      forceCollidedOntoPpu = buffer.readi32(b, p) ~= 0
      p += 4
    else
      forceCollidedOntoPpu = buffer.readi8(b, p) ~= 0
      p += 1
    end
  else
    forceCollidedOntoPpu = false
  end

  if BV == 130 then p = G.skip(s, p, 3) end

  if BV ~= 130 then p = G.skip(s, p, 12) end

  return {
    havokFilter = havokFilter,
    responseType = responseType,
    processContactDelay = processContactDelay,
    translation = translation,
    rotation = rotation,
    linearVelocity = linearVelocity,
    angularVelocity = angularVelocity,
    inertiaTensor = inertiaTensor,
    center = center,
    mass = mass,
    linearDamping = linearDamping,
    angularDamping = angularDamping,
    timeFactor = timeFactor,
    gravityFactor = gravityFactor,
    friction = friction,
    rollingFrictionMult = rollingFrictionMult,
    restitution = restitution,
    maxLinearVelocity = maxLinearVelocity,
    maxAngularVelocity = maxAngularVelocity,
    penetrationDepth = penetrationDepth,
    motionType = motionType,
    deactivatorType = deactivatorType,
    enableDeactivation = enableDeactivation,
    solverDeactivation = solverDeactivation,
    qualityType = qualityType,
    autoRemoveLevel = autoRemoveLevel,
    responseModifierFlags = responseModifierFlags,
    numContactPointShapeKeys = numContactPointShapeKeys,
    forceCollidedOntoPpu = forceCollidedOntoPpu,
  },
    p
end

