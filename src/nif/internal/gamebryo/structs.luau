function read.BSSubIndexTriShapeSubSegmentDataRecord(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local userSlotId
  local material
  local extraData
  userSlotId = buffer.readu32(b, p)
  p += 4
  material = buffer.readu32(b, p)
  p += 4

  do
    local count = buffer.readu32(b, p)
    p += 4

    if p + count * 4 > s.n then G.viewFail(s, p, count, 'f32', 4, true) end

    extraData = if count == 0
      then Empties.f32
      else setmetatable({ buffer = b, offset = p, count = count, stride = 4 }, Metas.f32)
    p += count * 4
  end

  return { userSlotId = userSlotId, material = material, extraData = extraData }, p
end

