  local scale
  local rotation
  local transformMethod
  local origin
  offset = vector.create(buffer.readf32(b, p), buffer.readf32(b, p + 4), 0)
  p += 8
  scale = vector.create(buffer.readf32(b, p), buffer.readf32(b, p + 4), 0)
