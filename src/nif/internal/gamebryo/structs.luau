function read.ControlledBlock(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local targetName
  local interpolator
  local controller
  local blendInterpolator = -1
  local blendIndex = 0
  local priority = 0
  local _offsets = false
  local stringPalette = -1
  local nodeNameOffset = 0
  local propertyTypeOffset = 0
  local controllerTypeOffset = 0
  local controllerIdOffset = 0
  local interpolatorIdOffset = 0
  local nodeName = ''
  local propertyType = ''
  local controllerType = ''
  local controllerId = ''
  local interpolatorId = ''

  if V <= 0x0A010067 then
    targetName, p = G.sizedU32(s, p)
  else
    targetName = ''
  end

  if V >= 0x0A01006A then
    interpolator = buffer.readi32(b, p)
    p += 4
    if interpolator < -1 then G.invalidLink(interpolator) end
  else
    interpolator = -1
  end

  if V <= 0x14050000 then
    controller = buffer.readi32(b, p)
    p += 4
    if controller < -1 then G.invalidLink(controller) end
  else
    controller = -1
  end

  if not (V <= 0x0A010067) then
    if V <= 0x0A01006E then
      blendInterpolator = buffer.readi32(b, p)
      p += 4
      if blendInterpolator < -1 then G.invalidLink(blendInterpolator) end
    end

    if V <= 0x0A01006E then
      blendIndex = buffer.readu16(b, p)
      p += 2
    end

    if V >= 0x0A01006A and BV > 0 then
      priority = buffer.readu8(b, p)
      p += 1
    end

    _offsets = V >= 0x0A020000 and V <= 0x14010000

    if _offsets then
      stringPalette = buffer.readi32(b, p)
      p += 4
      if stringPalette < -1 then G.invalidLink(stringPalette) end
    end

    if _offsets then
      nodeNameOffset = buffer.readu32(b, p)
      p += 4
    end

    if _offsets then
      propertyTypeOffset = buffer.readu32(b, p)
      p += 4
    end

    if _offsets then
      controllerTypeOffset = buffer.readu32(b, p)
      p += 4
    end

    if _offsets then
      controllerIdOffset = buffer.readu32(b, p)
      p += 4
    end

    if _offsets then
      interpolatorIdOffset = buffer.readu32(b, p)
      p += 4
    end

    if not _offsets then
      if V >= 0x14010001 then
        nodeName = s.strings[buffer.readu32(b, p) + 1] or G.stringIndex(s, buffer.readu32(b, p))
        p += 4
      else
        nodeName, p = G.sizedU32(s, p)
      end
    end

    if not _offsets then
      if V >= 0x14010001 then
        propertyType = s.strings[buffer.readu32(b, p) + 1] or G.stringIndex(s, buffer.readu32(b, p))
        p += 4
      else
        propertyType, p = G.sizedU32(s, p)
      end
    end

    if not _offsets then
      if V >= 0x14010001 then
        controllerType = s.strings[buffer.readu32(b, p) + 1]
          or G.stringIndex(s, buffer.readu32(b, p))
        p += 4
      else
        controllerType, p = G.sizedU32(s, p)
      end
    end

    if not _offsets then
      if V >= 0x14010001 then
        controllerId = s.strings[buffer.readu32(b, p) + 1] or G.stringIndex(s, buffer.readu32(b, p))
        p += 4
      else
        controllerId, p = G.sizedU32(s, p)
      end
    end

    if not _offsets then
      if V >= 0x14010001 then
        interpolatorId = s.strings[buffer.readu32(b, p) + 1]
          or G.stringIndex(s, buffer.readu32(b, p))
        p += 4
      else
        interpolatorId, p = G.sizedU32(s, p)
      end
    end
  end

  return {
    targetName = targetName,
    interpolator = interpolator,
    controller = controller,
    blendInterpolator = blendInterpolator,
    blendIndex = blendIndex,
    priority = priority,
    stringPalette = stringPalette,
    nodeNameOffset = nodeNameOffset,
    propertyTypeOffset = propertyTypeOffset,
    controllerTypeOffset = controllerTypeOffset,
    controllerIdOffset = controllerIdOffset,
    interpolatorIdOffset = interpolatorIdOffset,
    nodeName = nodeName,
    propertyType = propertyType,
    controllerType = controllerType,
    controllerId = controllerId,
    interpolatorId = interpolatorId,
  },
    p
end

