function read.NiGeometryMaterialData(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local _count = 0
  local _flag = false
  local names = G.empty
  local extra = Empties.i32
  local active = -1
  local needsUpdate = false

  if not (V < 0x0A000100) then
    if V >= 0x14020005 then
      _count = buffer.readu32(b, p)
      p += 4
    end

    if V < 0x14020005 and V <= 0x14010003 then
      if V < 0x04010000 then
        _flag = buffer.readi32(b, p) ~= 0
        p += 4
      else
        _flag = buffer.readi8(b, p) ~= 0
        p += 1
      end
    end

    _count = if _flag then 1 else _count

    do
      local count = _count
      G.checkSize(s, count * 4)

      do
        local __list = table.create(count)

        for i = 1, count do
          if V >= 0x14010001 then
            __list[i] = s.strings[buffer.readu32(b, p) + 1]
              or G.stringIndex(s, buffer.readu32(b, p))
            p += 4
          else
            __list[i], p = G.sizedU32(s, p)
          end
        end

        names = __list
      end
    end

    do
      local count = _count

      if p + count * 4 > s.n then G.viewFail(s, p, count, 'i32', 4, true) end

      extra = if count == 0
        then Empties.i32
        else setmetatable({ buffer = b, offset = p, count = count, stride = 4 }, Metas.i32)
      p += count * 4
    end

    if V >= 0x14020005 then
      active = buffer.readi32(b, p)
      p += 4
    end

    if V >= 0x14020007 then
      if V < 0x04010000 then
        needsUpdate = buffer.readi32(b, p) ~= 0
        p += 4
      else
        needsUpdate = buffer.readi8(b, p) ~= 0
        p += 1
      end
    end
  end

  return { names = names, extra = extra, active = active, needsUpdate = needsUpdate }, p
end

