function rows.bhkStiffSpringConstraintCInfo(b: buffer, p: number): any
  return { pivotA = G.vec4(b, p), pivotB = G.vec4(b, p + 16), length = buffer.readf32(b, p + 32) }
end

function read.bhkVelocityConstraintMotor(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local minForce
  local maxForce
  local tau
  local targetVelocity
  local useVelocityTarget
  local enabled
  minForce = buffer.readf32(b, p)
  p += 4
  maxForce = buffer.readf32(b, p)
  p += 4
  tau = buffer.readf32(b, p)
  p += 4
  targetVelocity = buffer.readf32(b, p)
  p += 4

  if V < 0x04010000 then
    useVelocityTarget = buffer.readi32(b, p) ~= 0
    p += 4
  else
    useVelocityTarget = buffer.readi8(b, p) ~= 0
    p += 1
  end

  if V < 0x04010000 then
    enabled = buffer.readi32(b, p) ~= 0
    p += 4
  else
    enabled = buffer.readi8(b, p) ~= 0
    p += 1
  end

  return {
    minForce = minForce,
    maxForce = maxForce,
    tau = tau,
    targetVelocity = targetVelocity,
    useVelocityTarget = useVelocityTarget,
    enabled = enabled,
  },
    p
end

function default.bhkVelocityConstraintMotor(): any
  local made = shared.bhkVelocityConstraintMotor
  if made then return made end

  made = table.freeze {
    minForce = 0,
    maxForce = 0,
    tau = 0,
    targetVelocity = 0,
    useVelocityTarget = false,
    enabled = false,
  }
  shared.bhkVelocityConstraintMotor = made
  return made
end

function read.bhkWorldObjCInfoProperty(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local data
  local size
  local capacityAndFlags
  data = buffer.readu32(b, p)
  p += 4
  size = buffer.readu32(b, p)
  p += 4
  capacityAndFlags = buffer.readu32(b, p)
  p += 4

  return { data = data, size = size, capacityAndFlags = capacityAndFlags }, p
end

function default.bhkWorldObjCInfoProperty(): any
  local made = shared.bhkWorldObjCInfoProperty
  if made then return made end

  made = table.freeze { data = 0, size = 0, capacityAndFlags = 0 }
  shared.bhkWorldObjCInfoProperty = made
  return made
end

function rows.bhkWorldObjCInfoProperty(b: buffer, p: number): any
  return {
    data = buffer.readu32(b, p),
    size = buffer.readu32(b, p + 4),
    capacityAndFlags = buffer.readu32(b, p + 8),
  }
end

function read.bhkWorldObjectCInfo(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local phaseType
  local property
  p = G.skip(s, p, 4)
  phaseType = buffer.readu8(b, p)
  p += 1
  p = G.skip(s, p, 3)
  property = {
    data = buffer.readu32(b, p),
    size = buffer.readu32(b, p + 4),
    capacityAndFlags = buffer.readu32(b, p + 8),
  }
  p += 12

  return { phaseType = phaseType, property = property }, p
end

function default.bhkWorldObjectCInfo(): any
  local made = shared.bhkWorldObjectCInfo
  if made then return made end

  made = table.freeze { phaseType = 0, property = D.bhkWorldObjCInfoProperty() }
  shared.bhkWorldObjectCInfo = made
  return made
end

function read.bhkWrappedConstraintData(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local type
  local info
  local ballAndSocketInfo
  local hingeInfo
  local limitedHingeInfo
  local prismaticInfo
  local ragdollInfo
  local stiffSpringInfo
  local _plain
  local malleableInfo
  type = buffer.readu32(b, p)
  p += 4
  info, p = R.bhkConstraintCInfo(s, p)

  if type == 0 then
    ballAndSocketInfo = { pivotA = G.vec4(b, p), pivotB = G.vec4(b, p + 16) }
    p += 32
  else
    ballAndSocketInfo = D.bhkBallAndSocketConstraintCInfo()
  end

  if type == 1 then
    hingeInfo, p = R.bhkHingeConstraintCInfo(s, p)
  else
    hingeInfo = D.bhkHingeConstraintCInfo()
  end

  if type == 2 then
    limitedHingeInfo, p = R.bhkLimitedHingeConstraintCInfo(s, p)
  else
    limitedHingeInfo = D.bhkLimitedHingeConstraintCInfo()
  end

  if type == 6 then
    prismaticInfo, p = R.bhkPrismaticConstraintCInfo(s, p)
  else
    prismaticInfo = D.bhkPrismaticConstraintCInfo()
  end

  if type == 7 then
    ragdollInfo, p = R.bhkRagdollConstraintCInfo(s, p)
  else
    ragdollInfo = D.bhkRagdollConstraintCInfo()
  end

  if type == 8 then
    stiffSpringInfo =
      { pivotA = G.vec4(b, p), pivotB = G.vec4(b, p + 16), length = buffer.readf32(b, p + 32) }
    p += 36
  else
    stiffSpringInfo = D.bhkStiffSpringConstraintCInfo()
  end

  _plain = type == 0 or type == 1 or type == 2 or type == 6 or type == 7 or type == 8
  if not (_plain or type == 13) then
    G.fail(`Unrecognized constraint type in bhkWrappedConstraintData`)
  end

  if not _plain then
    malleableInfo, p = R.bhkMalleableConstraintCInfo(s, p)
  else
    malleableInfo = D.bhkMalleableConstraintCInfo()
  end

  return {
    type = type,
    info = info,
    ballAndSocketInfo = ballAndSocketInfo,
    hingeInfo = hingeInfo,
    limitedHingeInfo = limitedHingeInfo,
    prismaticInfo = prismaticInfo,
    ragdollInfo = ragdollInfo,
    stiffSpringInfo = stiffSpringInfo,
    malleableInfo = malleableInfo,
  },
    p
end

function default.bhkWrappedConstraintData(): any
  local made = shared.bhkWrappedConstraintData
  if made then return made end

  made = table.freeze {
    type = 0,
    info = D.bhkConstraintCInfo(),
    ballAndSocketInfo = D.bhkBallAndSocketConstraintCInfo(),
    hingeInfo = D.bhkHingeConstraintCInfo(),
    limitedHingeInfo = D.bhkLimitedHingeConstraintCInfo(),
    prismaticInfo = D.bhkPrismaticConstraintCInfo(),
    ragdollInfo = D.bhkRagdollConstraintCInfo(),
    stiffSpringInfo = D.bhkStiffSpringConstraintCInfo(),
    malleableInfo = D.bhkMalleableConstraintCInfo(),
  }
  shared.bhkWrappedConstraintData = made
  return made
end

function read.hkSubPartData(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local havokFilter
  local numVertices
  local havokMaterial
  havokFilter = {
    layer = buffer.readu8(b, p),
    flags = buffer.readu8(b, p + 1),
    group = buffer.readu16(b, p + 2),
  }
  p += 4
  numVertices = buffer.readu32(b, p)
  p += 4
  havokMaterial, p = R.HavokMaterial(s, p)

  return { havokFilter = havokFilter, numVertices = numVertices, havokMaterial = havokMaterial }, p
end

function default.hkSubPartData(): any
  local made = shared.hkSubPartData
  if made then return made end

  made = table.freeze {
    havokFilter = D.HavokFilter(),
    numVertices = 0,
    havokMaterial = D.HavokMaterial(),
  }
  shared.hkSubPartData = made
  return made
end

function read.hkpMoppCode(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local _dataSize
  local offset
  local buildType
  local data
  _dataSize = buffer.readu32(b, p)
  p += 4

  if V >= 0x0A010000 then
    offset = {
      buffer.readf32(b, p),
      buffer.readf32(b, p + 4),
      buffer.readf32(b, p + 8),
      buffer.readf32(b, p + 12),
    }
    p += 16
  else
    offset = G.zero4
  end

  if BV > 34 then
    buildType = buffer.readu8(b, p)
    p += 1
  else
    buildType = 0
  end

  do
    local count = _dataSize

    if p + count * 1 > s.n then G.viewFail(s, p, count, 'u8', 1, true) end

    data = if count == 0
      then Empties.u8
      else setmetatable({ buffer = b, offset = p, count = count, stride = 1 }, Metas.u8)
    p += count * 1
  end

  return { offset = offset, buildType = buildType, data = data }, p
end

function default.hkpMoppCode(): any
  local made = shared.hkpMoppCode
  if made then return made end

  made = table.freeze { offset = G.zero4, buildType = 0, data = Empties.u8 }
  shared.hkpMoppCode = made
  return made
end

return { read = read, default = default, rows = rows }
