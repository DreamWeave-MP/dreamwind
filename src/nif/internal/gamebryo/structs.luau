function read.bhkCMSChunk(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local translation
  local materialIndex
  local reference
  local transformIndex
  local vertices
  local indices
  local strips
  local weldingInfos
  translation = {
    buffer.readf32(b, p),
    buffer.readf32(b, p + 4),
    buffer.readf32(b, p + 8),
    buffer.readf32(b, p + 12),
  }
  p += 16
  materialIndex = buffer.readu32(b, p)
  p += 4
  reference = buffer.readu16(b, p)
  p += 2
  transformIndex = buffer.readu16(b, p)
  p += 2

  do
    local count = buffer.readu32(b, p)
    p += 4

    if p + count * 2 > s.n then G.viewFail(s, p, count, 'u16', 2, true) end

    vertices = if count == 0
      then Empties.u16
      else setmetatable({ buffer = b, offset = p, count = count, stride = 2 }, Metas.u16)
    p += count * 2
  end

  do
    local count = buffer.readu32(b, p)
    p += 4

    if p + count * 2 > s.n then G.viewFail(s, p, count, 'u16', 2, true) end

    indices = if count == 0
      then Empties.u16
      else setmetatable({ buffer = b, offset = p, count = count, stride = 2 }, Metas.u16)
    p += count * 2
  end

  do
    local count = buffer.readu32(b, p)
    p += 4

    if p + count * 2 > s.n then G.viewFail(s, p, count, 'u16', 2, true) end

    strips = if count == 0
      then Empties.u16
      else setmetatable({ buffer = b, offset = p, count = count, stride = 2 }, Metas.u16)
    p += count * 2
  end

  do
    local count = buffer.readu32(b, p)
    p += 4

    if p + count * 2 > s.n then G.viewFail(s, p, count, 'u16', 2, true) end

    weldingInfos = if count == 0
      then Empties.u16
      else setmetatable({ buffer = b, offset = p, count = count, stride = 2 }, Metas.u16)
    p += count * 2
  end

  return {
    translation = translation,
    materialIndex = materialIndex,
    reference = reference,
    transformIndex = transformIndex,
    vertices = vertices,
    indices = indices,
    strips = strips,
    weldingInfos = weldingInfos,
  },
    p
end

