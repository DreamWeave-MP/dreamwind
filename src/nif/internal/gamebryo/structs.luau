function read.BSSubIndexTriShapeSubSegmentData(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local _arrayIndices
  local _records
  local arrayIndices
  local dataRecords
  local ssfFile
  _arrayIndices = buffer.readu32(b, p)
  p += 4
  _records = buffer.readu32(b, p)
  p += 4

  do
    local count = _arrayIndices
    G.checkSize(s, count * 4)

    do
      local __list = table.create(count)

      for i = 1, count do
        __list[i] = buffer.readu32(b, p)
        p += 4
      end

      arrayIndices = __list
    end
  end

  do
    local count = _records

    do
      local __list = table.create(count)

      for i = 1, count do
        __list[i], p = R.BSSubIndexTriShapeSubSegmentDataRecord(s, p)
      end

      dataRecords = __list
    end
  end

  ssfFile, p = C.sizedU16(s, p)

  return { arrayIndices = arrayIndices, dataRecords = dataRecords, ssfFile = ssfFile }, p
end

