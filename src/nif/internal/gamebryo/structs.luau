function read.BSSubIndexTriShapeSegmentation(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local numPrimitives
  local _segments
  local numTotalSegments
  local segments
  local subSegmentData
  numPrimitives = buffer.readu32(b, p)
  p += 4
  _segments = buffer.readu32(b, p)
  p += 4
  numTotalSegments = buffer.readu32(b, p)
  p += 4

  do
    local count = _segments

    do
      local __list = table.create(count)

      for i = 1, count do
        __list[i], p = R.BSSubIndexTriShapeSegment(s, p)
      end

      segments = __list
    end
  end

  if _segments < numTotalSegments then
    subSegmentData, p = R.BSSubIndexTriShapeSubSegmentData(s, p)
  else
    subSegmentData = D.BSSubIndexTriShapeSubSegmentData()
  end

  return {
    numPrimitives = numPrimitives,
    numTotalSegments = numTotalSegments,
    segments = segments,
    subSegmentData = subSegmentData,
