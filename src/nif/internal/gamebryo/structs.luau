function read.NiQuatTransform(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local translation
  local rotation
  local scale
  local _hasTranslation = false
  local _hasRotation = false
  local _hasScale = false
  translation =
    vector.create(buffer.readf32(b, p), buffer.readf32(b, p + 4), buffer.readf32(b, p + 8))
  p += 12
  rotation = {
    buffer.readf32(b, p + 4),
    buffer.readf32(b, p + 8),
    buffer.readf32(b, p + 12),
    buffer.readf32(b, p),
  }
  p += 16
  scale = buffer.readf32(b, p)
  p += 4

  if not (V >= 0x0A01006E) then
    if V < 0x04010000 then
      _hasTranslation = buffer.readi32(b, p) ~= 0
      p += 4
    else
      _hasTranslation = buffer.readi8(b, p) ~= 0
      p += 1
    end

    translation = if _hasTranslation then translation else vector.zero

    if V < 0x04010000 then
      _hasRotation = buffer.readi32(b, p) ~= 0
      p += 4
    else
      _hasRotation = buffer.readi8(b, p) ~= 0
      p += 1
    end

    rotation = if _hasRotation then rotation else { 0, 0, 0, 1 }

    if V < 0x04010000 then
      _hasScale = buffer.readi32(b, p) ~= 0
      p += 4
    else
      _hasScale = buffer.readi8(b, p) ~= 0
      p += 1
    end

    scale = if _hasScale then scale else 1
  end

  return { translation = translation, rotation = rotation, scale = scale }, p
end

function default.NiQuatTransform(): any
  local made = shared.NiQuatTransform
  if made then return made end

  made = table.freeze { translation = vector.zero, rotation = G.unitQuat, scale = 1 }
  shared.NiQuatTransform = made
  return made
end

function read.NiSkinPartitionPartition(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local _numVertices
  local _numTriangles
  local _numBones
  local _numStrips
  local _bonesPerVertex
  local bones
  local _hasVertexMap
  local vertexMap
  local _hasWeights
  local weights
  local _stripLengths
  local _hasFaces
  local triangles
  local strips
  local _hasBoneIndices
  local boneIndices
  local lodLevel
  local globalVb
  local vertexDesc
  local trueTriangles = Empties.u16
  local _remap
  local trueStrips
  _numVertices = buffer.readu16(b, p)
  p += 2
  _numTriangles = buffer.readu16(b, p)
  p += 2
  _numBones = buffer.readu16(b, p)
  p += 2
  _numStrips = buffer.readu16(b, p)
  p += 2
  _bonesPerVertex = buffer.readu16(b, p)
  p += 2

  do
    local count = _numBones

    if p + count * 2 > s.n then G.viewFail(s, p, count, 'u16', 2, true) end

    bones = if count == 0
      then Empties.u16
      else setmetatable({ buffer = b, offset = p, count = count, stride = 2 }, Metas.u16)
    p += count * 2
  end

  if V >= 0x0A010000 then
    if V < 0x04010000 then
      _hasVertexMap = buffer.readi32(b, p) ~= 0
      p += 4
    else
      _hasVertexMap = buffer.readi8(b, p) ~= 0
      p += 1
    end
  else
    _hasVertexMap = true
  end

  if _hasVertexMap then
    do
      local count = _numVertices

      if p + count * 2 > s.n then G.viewFail(s, p, count, 'u16', 2, true) end

      vertexMap = if count == 0
        then Empties.u16
        else setmetatable({ buffer = b, offset = p, count = count, stride = 2 }, Metas.u16)
      p += count * 2
    end
  else
    vertexMap = Empties.u16
  end

  if V >= 0x0A010000 then
    if V < 0x04010000 then
      _hasWeights = buffer.readi32(b, p) ~= 0
      p += 4
    else
      _hasWeights = buffer.readi8(b, p) ~= 0
      p += 1
    end
  else
    _hasWeights = true
  end

  if _hasWeights then
    do
      local count = _numVertices * _bonesPerVertex

      if p + count * 4 > s.n then G.viewFail(s, p, count, 'f32', 4, true) end

      weights = if count == 0
        then Empties.f32
        else setmetatable({ buffer = b, offset = p, count = count, stride = 4 }, Metas.f32)
      p += count * 4
    end
  else
    weights = Empties.f32
  end

  do
    local count = _numStrips

    if p + count * 2 > s.n then G.viewFail(s, p, count, 'u16', 2, true) end

    _stripLengths = if count == 0
      then Empties.u16
      else setmetatable({ buffer = b, offset = p, count = count, stride = 2 }, Metas.u16)
    p += count * 2
  end

  if V >= 0x0A010000 then
    if V < 0x04010000 then
      _hasFaces = buffer.readi32(b, p) ~= 0
      p += 4
    else
      _hasFaces = buffer.readi8(b, p) ~= 0
      p += 1
    end
  else
    _hasFaces = true
  end

  if _hasFaces and _numStrips == 0 then
    do
      local count = _numTriangles * 3

      if p + count * 2 > s.n then G.viewFail(s, p, count, 'u16', 2, true) end

      triangles = if count == 0
        then Empties.u16
        else setmetatable({ buffer = b, offset = p, count = count, stride = 2 }, Metas.u16)
      p += count * 2
    end
  else
    triangles = Empties.u16
  end

  if _hasFaces and _numStrips ~= 0 then
    strips, p = C.strips(s, p, _stripLengths)
  else
    strips = {}
  end

  _hasBoneIndices = buffer.readu8(b, p)
  p += 1

  if _hasBoneIndices ~= 0 then
    do
      local count = _numVertices * _bonesPerVertex

      if p + count * 1 > s.n then G.viewFail(s, p, count, 'u8', 1, true) end

      boneIndices = if count == 0
        then Empties.u8
        else setmetatable({ buffer = b, offset = p, count = count, stride = 1 }, Metas.u8)
      p += count * 1
    end
  else
    boneIndices = Empties.u8
  end

  if BV > 34 then
    lodLevel = buffer.readu8(b, p)
    p += 1
  else
    lodLevel = 0
  end

  if BV > 34 then
    if V < 0x04010000 then
      globalVb = buffer.readi32(b, p) ~= 0
      p += 4
    else
      globalVb = buffer.readi8(b, p) ~= 0
      p += 1
    end
  else
    globalVb = false
  end

  if BV == 100 then
    vertexDesc, p = C.vertexDesc(s, p)
  else
    vertexDesc = C.noVertexDesc()
  end

  if BV == 100 then
    do
      local count = _numTriangles * 3

      if p + count * 2 > s.n then G.viewFail(s, p, count, 'u16', 2, true) end

      trueTriangles = if count == 0
        then Empties.u16
        else setmetatable({ buffer = b, offset = p, count = count, stride = 2 }, Metas.u16)
      p += count * 2
    end
  end

  _remap = #trueTriangles == 0 and #vertexMap > 0

  if _remap and #strips > 0 then
    trueStrips = C.remapStrips(strips, vertexMap)
  else
    trueStrips = {}
  end

  if _remap and #strips == 0 and #triangles > 0 then
    trueTriangles = C.remap(triangles, vertexMap)
  end

  return {
    bones = bones,
    vertexMap = vertexMap,
    weights = weights,
    triangles = triangles,
    strips = strips,
    boneIndices = boneIndices,
    lodLevel = lodLevel,
    globalVb = globalVb,
    vertexDesc = vertexDesc,
    trueTriangles = trueTriangles,
    trueStrips = trueStrips,
  },
    p
end

function default.NiSkinPartitionPartition(): any
  local made = shared.NiSkinPartitionPartition
  if made then return made end

  made = table.freeze {
    bones = Empties.u16,
    vertexMap = Empties.u16,
    weights = Empties.f32,
    triangles = Empties.u16,
    strips = {},
    boneIndices = Empties.u8,
    lodLevel = 0,
    globalVb = false,
    vertexDesc = C.noVertexDesc(),
    trueTriangles = Empties.u16,
    trueStrips = {},
  }
  shared.NiSkinPartitionPartition = made
  return made
end

