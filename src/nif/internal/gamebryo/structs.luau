    rotation = G.mat3(b, p),
    translation = vector.create(
      buffer.readf32(b, p + 36),
      buffer.readf32(b, p + 40),
      buffer.readf32(b, p + 44)
    ),
    scale = buffer.readf32(b, p + 48),
  }
  p += 52

  return { boundSphere = boundSphere, transform = transform }, p
end

