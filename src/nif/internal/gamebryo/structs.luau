function read.NiPixelFormat(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local format
  local colorMasks
  local bitsPerPixel = 0
  local compareBits
  local pixelTiling = 0
  local rendererHint
  local extraData
  local flags
  local useSrgb
  local channels
  format = buffer.readu32(b, p)
  p += 4

  if V <= 0x0A040001 then
    do
      local __list = table.create(4)

      for i = 1, 4 do
        __list[i] = buffer.readu32(b, p)
        p += 4
      end

      colorMasks = __list
    end
  else
    colorMasks = table.create(4, 0)
  end

  if V <= 0x0A040001 then
    bitsPerPixel = buffer.readu32(b, p)
    p += 4
  end

  if V <= 0x0A040001 then
    do
      local __list = table.create(2)

      for i = 1, 2 do
        __list[i] = buffer.readu32(b, p)
        p += 4
      end

      compareBits = __list
    end
  else
    compareBits = table.create(2, 0)
  end

  if V <= 0x0A040001 and V >= 0x0A010000 then
    pixelTiling = buffer.readu32(b, p)
    p += 4
  end

  if V > 0x0A040001 then
    bitsPerPixel = buffer.readu8(b, p)
    p += 1
  end

  if V > 0x0A040001 then
    rendererHint = buffer.readu32(b, p)
    p += 4
  else
    rendererHint = 0
  end

  if V > 0x0A040001 then
    extraData = buffer.readu32(b, p)
    p += 4
  else
    extraData = 0
  end

  if V > 0x0A040001 then
    flags = buffer.readu8(b, p)
    p += 1
  else
    flags = 0
  end

  if V > 0x0A040001 then
    pixelTiling = buffer.readu32(b, p)
    p += 4
  end

  if V > 0x0A040001 and V >= 0x14030004 then
    if V < 0x04010000 then
      useSrgb = buffer.readi32(b, p) ~= 0
      p += 4
    else
      useSrgb = buffer.readi8(b, p) ~= 0
      p += 1
    end
  else
    useSrgb = false
  end

  if V > 0x0A040001 then
    channels, p = G.structRows(s, p, 4, R.NiPixelFormatChannelData)
  else
    channels = {
      D.NiPixelFormatChannelData(),
      D.NiPixelFormatChannelData(),
      D.NiPixelFormatChannelData(),
      D.NiPixelFormatChannelData(),
    }
  end

  return {
    format = format,
    colorMasks = colorMasks,
    bitsPerPixel = bitsPerPixel,
    compareBits = compareBits,
    pixelTiling = pixelTiling,
    rendererHint = rendererHint,
    extraData = extraData,
    flags = flags,
    useSrgb = useSrgb,
    channels = channels,
  },
    p
end

function default.NiPixelFormat(): any
  local made = shared.NiPixelFormat
  if made then return made end

  made = table.freeze {
    format = 0,
    colorMasks = table.create(4, 0),
    bitsPerPixel = 0,
    compareBits = table.create(2, 0),
    pixelTiling = 0,
    rendererHint = 0,
    extraData = 0,
    flags = 0,
    useSrgb = false,
    channels = {
      D.NiPixelFormatChannelData(),
      D.NiPixelFormatChannelData(),
      D.NiPixelFormatChannelData(),
      D.NiPixelFormatChannelData(),
    },
  }
  shared.NiPixelFormat = made
  return made
end

function read.NiPixelFormatChannelData(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local type
  local convention
  local bitsPerChannel
  local signed
  type = buffer.readu32(b, p)
  p += 4
  convention = buffer.readu32(b, p)
  p += 4
  bitsPerChannel = buffer.readu8(b, p)
  p += 1

  if V < 0x04010000 then
    signed = buffer.readi32(b, p) ~= 0
    p += 4
  else
    signed = buffer.readi8(b, p) ~= 0
    p += 1
  end

  return { type = type, convention = convention, bitsPerChannel = bitsPerChannel, signed = signed },
    p
end

