function read.bhkMalleableConstraintCInfo(s: G.Stream, p: number): (any, number)
  local b, V, UV, BV = s.b, s.version, s.userVersion, s.bethVersion
  local type
  local info
  local ballAndSocketInfo
  local hingeInfo
  local limitedHingeInfo
  local prismaticInfo
  local ragdollInfo
  local stiffSpringInfo
  local _plain
  local tau
  local damping
  local strength
  type = buffer.readu32(b, p)
  p += 4
  info, p = R.bhkConstraintCInfo(s, p)

  if type == 0 then
    ballAndSocketInfo = { pivotA = G.vec4(b, p), pivotB = G.vec4(b, p + 16) }
    p += 32
  else
    ballAndSocketInfo = D.bhkBallAndSocketConstraintCInfo()
  end

  if type == 1 then
    hingeInfo, p = R.bhkHingeConstraintCInfo(s, p)
  else
    hingeInfo = D.bhkHingeConstraintCInfo()
  end

  if type == 2 then
    limitedHingeInfo, p = R.bhkLimitedHingeConstraintCInfo(s, p)
  else
    limitedHingeInfo = D.bhkLimitedHingeConstraintCInfo()
  end

  if type == 6 then
    prismaticInfo, p = R.bhkPrismaticConstraintCInfo(s, p)
  else
    prismaticInfo = D.bhkPrismaticConstraintCInfo()
  end

  if type == 7 then
    ragdollInfo, p = R.bhkRagdollConstraintCInfo(s, p)
  else
    ragdollInfo = D.bhkRagdollConstraintCInfo()
  end

  if type == 8 then
    stiffSpringInfo =
      { pivotA = G.vec4(b, p), pivotB = G.vec4(b, p + 16), length = buffer.readf32(b, p + 32) }
    p += 36
  else
    stiffSpringInfo = D.bhkStiffSpringConstraintCInfo()
  end

  _plain = type == 0 or type == 1 or type == 2 or type == 6 or type == 7 or type == 8
  if not _plain then G.fail(`Unrecognized constraint type in bhkMalleableConstraint`) end

  if V <= 0x14000005 then
    tau = buffer.readf32(b, p)
    p += 4
  else
    tau = 0
  end

  if V <= 0x14000005 then
    damping = buffer.readf32(b, p)
    p += 4
  else
    damping = 0
  end

  if V > 0x14000005 then
    strength = buffer.readf32(b, p)
    p += 4
  else
    strength = 0
  end

  return {
    type = type,
    info = info,
    ballAndSocketInfo = ballAndSocketInfo,
    hingeInfo = hingeInfo,
    limitedHingeInfo = limitedHingeInfo,
    prismaticInfo = prismaticInfo,
    ragdollInfo = ragdollInfo,
    stiffSpringInfo = stiffSpringInfo,
    tau = tau,
    damping = damping,
    strength = strength,
  },
    p
end

