--!strict
--!native
-- Walk record framing and identities without decoding payloads.
local fs = require '@dream/fs'
local tes3 = require '@esm'

local function run(scale: number, root: string): number
  local source, problem = fs.readFile(fs.join(root, 'tools', 'bench', 'assets', 'all_types.esp'))
  if not source then error(problem, 0) end
  local plugin = tes3.open(source)
  local rounds = math.max(1, math.floor(1000 * scale))

  local started = os.clock()
  local identified = 0
  for _ = 1, rounds do
    for index = 0, plugin:count() - 1 do
      plugin:code(index)
      if tes3.records.id(plugin, index) then identified += 1 end
    end
  end

  local elapsed = os.clock() - started
  assert(identified > rounds)
  return elapsed
end

return table.freeze {
  name = 'scan',
  path = 'tools/bench/canaries/scan.jsl',
  run = run,
}
