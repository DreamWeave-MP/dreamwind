-- SPDX-License-Identifier: MIT OR Apache-2.0

--[[
Freezes jess-nif's default records into `defaults.luau`: each Morrowind record type inserted
into an empty NIF with no fields set, saved, and kept as the bytes of its body, which the model
reads back into the table a record of that type starts as. Nested structs a record can hold
without them (a texturing property's maps) are frozen the same way, from a record with just
that struct set (one field at its default, so it reads as a struct). Needs jess-nif
(`jess.nif`), so it runs only while jess links it:

  jess run jpk/dreamwind/generators/nif/defaults.luau jpk/dreamwind/src/nif/internal
]]

local Nif = require '../../src/nif/init'

local outDir = ...
if not outDir then error('usage: defaults.luau <output folder>', 0) end

--- The body of the one record a saved NIF holds: after its type name, up to the roots.
local function body(fields: { [string]: unknown }): string
  local rust = jess.nif.new()
  local record = rust:insert(fields)
  rust:setRoots { record }
  local saved = rust:bytes()
  local port = Nif.open(saved)
  return buffer.readstring(saved, port.bodies[1], port.rootsAt - port.bodies[1])
end

--- A string as a Luau literal: printable ASCII as it is, every other byte escaped.
local function literal(text: string): string
  local escaped = string.gsub(
    text,
    '[^%w %.,:;_%-]',
    function(character: string): string return string.format('\\x%02x', string.byte(character)) end
  )
  return `'{escaped}'`
end

local lines = {
  '--!strict',
  '-- SPDX-License-Identifier: MIT OR Apache-2.0',
  '-- @generated by generators/nif/defaults.luau from jess-nif\'s default records. Do not edit.',
  '',
  '--- Each record type\'s body with every field at its default, as jess-nif encoded it.',
  'local Bodies = table.freeze({',
}

for _, name in Nif.recordTypes do
  table.insert(lines, `  {name} = {literal(body { type = name })},`)
end

table.insert(lines, '} :: { [string]: string })')
table.insert(lines, '')
table.insert(
  lines,
  '--- Records holding one nested struct at its default, by struct: the type and field path.'
)
table.insert(lines, 'local Structs = table.freeze {')

local structs = {
  {
    'TextureMap',
    'NiTexturingProperty',
    { textureMaps = { base = { textureIndex = 0 } } },
    'textureMaps.base',
  },

  {
    'BumpMap',
    'NiTexturingProperty',
    { textureMaps = { bump = { textureIndex = 0 } } },
    'textureMaps.bump',
  },
}

for position, entry in structs do
  if position > 1 then table.insert(lines, '') end

  local fields = table.clone(entry[3])
  fields.type = entry[2]
  table.insert(
    lines,
    `  {entry[1]} = \{ type = '{entry[2]}', path = '{entry[4]}', body = {literal(body(fields))} },`
  )
end

table.insert(lines, '}')
table.insert(lines, '')
table.insert(lines, 'return table.freeze { bodies = Bodies, structs = Structs }')
jess.fs.write(jess.fs.join(outDir, 'defaults.luau'), table.concat(lines, '\n') .. '\n')
print(`wrote defaults for {#Nif.recordTypes} record types and {#structs} structs`)
